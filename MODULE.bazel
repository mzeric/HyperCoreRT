module(
    name = "hypercore",
    version = "0.0.1",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "libfdt", version = "0.0.1")
bazel_dep(name = "arm_toolchain_aarch64_none_elf", version= "10.3.1")
bazel_dep(name = "rules_cc", version = "0.2.14")

# RISC-V cross-compilation toolchain
bazel_dep(name = "toolchains_riscv_gnu", version = "0.0.2")

single_version_override(
    module_name = "toolchains_riscv_gnu",
    patches = [
        "//patches:fix_riscv_rules_cc_compat.patch",
        "//patches:fix_riscv_target_constraints.patch",
    ],
    patch_strip = 1,
)

riscv_toolchain = use_extension("@toolchains_riscv_gnu//:extensions.bzl", "riscv_toolchain")
riscv_toolchain.riscv_none_elf(version = "13.2.0-2")
use_repo(riscv_toolchain, "riscv_none_elf")

register_toolchains("@riscv_none_elf//toolchain:all")
