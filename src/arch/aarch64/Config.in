config CONFIG_SMP
    bool "multiprocessor support"
    default y
    depends on CONFIG_ARCH_AARCH64
    help
        if Target arch suport smp

if CONFIG_SMP

config CONFIG_SMP_CPU_NUM
    int "CPU number"
    range 1 16
    default 4
endif

config CONFIG_PAGE_SHIFT
    int "memory page shift"
    range 10 50
    default 12
config CONFIG_PADDR_BITS
    int "physical address bits"
    range 1 50
    default 44
