menu "Core Options"
comment "configurations"



config CONFIG_INT_STACK_SIZE
	int "interrupt stack size"
	default 4096

config CONFIG_ENTRY_ADDR
	hex "entry addr"
	default 0x40000000

config CONFIG_PHY_MEM_SIZE
	hex "physical memory size"
	default 0x800000
config CONFIG_HOST_USE_2MB_MAPPING
	bool "use 2MB page-mapping for hypervisor self"
	default False
